# --- server ---
NODE_ENV=development
PORT=4000
LOG_LEVEL=debug
TRUST_PROXY=1

# --- database ---
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=maple_studios

# --- auth ---
# generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-me-with-at-least-32-random-characters
JWT_EXPIRES_IN=15m
REFRESH_EXPIRES_IN=7d

# Bridge for the site's existing x-admin-key. UNSET THIS once the
# dashboard logs in properly - while it is set, the old header still works.
LEGACY_ADMIN_KEY=

# --- misc ---
CORS_ORIGINS=http://localhost:3006,https://maple-studios.vercel.app
STUDIO_TIMEZONE=Asia/Kolkata

# seed script only
SEED_ADMIN_EMAIL=contact@maplestudios.co.in
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=Maple Studios

# --- growth platform (docs/platform/phase-1-spec.md) ---
PUBLIC_BASE_URL=https://maplestudios.co.in
# generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APP_ENCRYPTION_KEY=
SCHEDULER_ENABLED=true

# email sending — dry-run until this is a real re_… key from resend.com
MAIL_FROM_NAME=Maple Studios
MAIL_FROM_EMAIL=
RESEND_API_KEY=placeholder
RESEND_WEBHOOK_SECRET=

# social connect — see docs/platform/social-apps-setup.md
X_CLIENT_ID=
X_CLIENT_SECRET=
META_APP_ID=
META_APP_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
